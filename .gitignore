# -------------------------------------------------
#  AgroMart — Root .gitignore
# -------------------------------------------------

# -- Node / npm ------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# -- Environment variables (NEVER commit these) ----
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test

# keep examples so teammates know what vars are needed
!.env.example
!.env.local.example

# -- Next.js ---------------------------------------
frontend/.next/
frontend/out/
frontend/.vercel/
frontend/tsconfig.tsbuildinfo

# -- TypeScript build output -----------------------
dist/
build/
*.tsbuildinfo

# -- Prisma ----------------------------------------
# Generated client — regenerated by `prisma generate`
backend/node_modules/.prisma/
# Never ignore migrations — they are version-controlled source of truth

# -- Terraform -------------------------------------
infra/.terraform/
infra/.terraform.lock.hcl
infra/*.tfstate
infra/*.tfstate.*
infra/*.tfstate.backup
infra/terraform.tfvars
infra/override.tf
infra/override.tf.json
infra/*_override.tf
infra/*_override.tf.json

# -- Docker ----------------------------------------
postgres-data/
redis-data/

# -- Logs ------------------------------------------
logs/
*.log

# -- OS artefacts ----------------------------------
.DS_Store
._*
Thumbs.db
desktop.ini

# -- IDE / Editor ----------------------------------
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.history/

# -- Testing ---------------------------------------
coverage/
.nyc_output/

# -- Misc ------------------------------------------
*.pid
*.pid.lock
.cache/
